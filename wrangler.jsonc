// Cloudflare mirror with static assets. Build: `bash scripts/build-site.sh _site cloudflare`,
// deploy: `npx wrangler deploy`. GOOGLE_ANALYTICS_ID is a Workers Builds variable.
{
  "name": "matyszewski-co",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "run_worker_first": ["/live/ws"],
    // /uslugi/ serves uslugi/index.html; /uslugi redirects to /uslugi/, as on GitHub Pages.
    "html_handling": "auto-trailing-slash",
    // Unknown URLs get 404.html with a real 404 status.
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION",
        "class_name": "Session"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Session"]
    }
  ],
  "routes": [
    {
      "pattern": "matyszewski.co/live",
      "zone_name": "matyszewski.co"
    },
    {
      "pattern": "matyszewski.co/live/*",
      "zone_name": "matyszewski.co"
    }
  ],
  "workers_dev": true,
  "preview_urls": true
}
